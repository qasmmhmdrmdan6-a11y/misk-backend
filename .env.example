# انسخي الملف ده باسم .env واملي القيم الحقيقية
# متسيبيش .env يترفع على GitHub أو أي مكان عام أبدًا

# من Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ ده مفتاح سري جدًا (service role key) - بيدي صلاحية كاملة على قاعدة البيانات
# استخدميه في السيرفر بس، وممنوع يظهر في كود الفرونت إند نهائيًا
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# دومين المتجر بتاعك، عشان الباك إند يقبل طلبات منه بس (CORS)
FRONTEND_URL=https://your-store-domain.com

PORT=3000
